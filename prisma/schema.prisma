datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. SYSTEM TABLES (HÀNG ĐỢI, CACHE, SEQUENCES)
// ==========================================

model SystemJob {
  id          BigInt    @id @default(autoincrement())
  queueName   String    @map("queue_name") @db.VarChar(50)
  payload     String    @map("payload") @db.LongText
  status      String    @default("PENDING") @map("status") @db.VarChar(20)
  attempts    Int       @default(0) @map("attempts")
  maxAttempts Int       @default(3) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at") @db.DateTime(6)
  priority    Int       @default(0) @map("priority")
  lockedBy    String?   @map("locked_by") @db.VarChar(100)
  lockedAt    DateTime? @map("locked_at") @db.DateTime(6)
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(6)

  @@index([status, runAt, priority], map: "idx_system_jobs_status_run_pri")
  @@index([queueName, status], map: "idx_system_jobs_queue_status")
  @@map("_system_jobs")
}

model SystemJobDlq {
  id            BigInt   @id @default(autoincrement())
  originalJobId BigInt   @map("original_job_id")
  queueName     String   @map("queue_name") @db.VarChar(50)
  payload       String   @map("payload") @db.LongText
  errorStack    String?  @map("error_stack") @db.Text
  failedAt      DateTime @default(now()) @map("failed_at") @db.DateTime(6)

  @@index([queueName, failedAt], map: "idx_dlq_queue_failed")
  @@map("_system_jobs_dlq")
}

model SystemSequence {
  name       String   @id @map("name") @db.VarChar(50)
  currentVal BigInt   @default(0) @map("current_val")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  @@map("_system_sequences")
}

model SystemCache {
  key       String   @id @map("cache_key") @db.VarChar(255)
  value     String   @map("cache_value") @db.LongText
  tag       String?  @map("tag") @db.VarChar(100)
  expiresAt DateTime @map("expires_at") @db.DateTime(6)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  @@index([key, expiresAt], map: "idx_cache_key_exp")
  @@index([tag], map: "idx_cache_tag")
  @@map("_system_cache")
}

// ==========================================
// 2. NUTRI CLINICAL NUTRITION DOMAIN MODELS
// ==========================================

model benh_nhan {
  id                  BigInt                 @id @default(autoincrement())
  nguoi_dung_id       String                 @db.Char(36)
  ho_ten              String                 @db.VarChar(255)
  so_dien_thoai       String?                @db.VarChar(20)
  ngay_sinh           DateTime?              @db.Date
  gioi_tinh           String                 @db.VarChar(20)
  can_nang            Float?
  chieu_cao           Float?
  ghi_chu             String?                @db.Text
  he_so_hoat_dong     Float?
  ma_benh_nhan_bv     String?                @db.VarChar(255)
  tao_luc             DateTime?              @db.DateTime(6)
  chi_nam_sinh        Boolean?               @db.Bit(1)
  deleted_at          DateTime?              @map("deleted_at") @db.DateTime(0)
  tinh_trang_thai_san String?                @default("KHONG") @db.VarChar(50)
  di_ung              String?                @db.Text
  tien_su_benh        String?                @db.Text
  nhom_benh_chinh_id  Int?
  nguoi_dung          nguoi_dung             @relation(fields: [nguoi_dung_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "benh_nhan_ibfk_1")
  nhom_benh_mo_rong   nhom_benh_mo_rong?     @relation(fields: [nhom_benh_chinh_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_patient_main_disease")
  de_xuat_thuc_don    de_xuat_thuc_don[]
  khau_phan_24h       khau_phan_24h[]
  thuc_don            thuc_don[]
  benh_nhan_nhan_trac benh_nhan_nhan_trac[]
  benh_nhan_benh_an   benh_nhan_benh_an[]

  @@index([nguoi_dung_id], map: "benh_nhan_ibfk_1")
  @@index([nguoi_dung_id, ho_ten], map: "idx_patient_user_name")
  @@index([so_dien_thoai], map: "idx_patient_phone")
  @@index([ma_benh_nhan_bv], map: "idx_patient_bv_code")
  @@index([deleted_at], map: "idx_patient_deleted_at")
  @@index([nhom_benh_chinh_id], map: "idx_patient_main_disease")
}

model benh_nhan_nhan_trac {
