  nguoi_tao_id        String     @db.Char(36)
  tao_luc             DateTime   @default(now()) @db.DateTime(6)
  benh_nhan           benh_nhan  @relation(fields: [benh_nhan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_anthropometry_patient")
  nguoi_dung          nguoi_dung @relation(fields: [nguoi_tao_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_anthropometry_creator")

  @@index([benh_nhan_id, ngay_do(sort: Desc)], map: "idx_anthropometry_patient_date")
  @@index([nguoi_tao_id], map: "idx_anthropometry_creator")
