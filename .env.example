# ==============================================================================
# Nutri Clinical Nutrition & Diet Management System - Environment Template
# Production Hardened Security Configuration
# NOTE: DO NOT COMMIT REAL PRODUCTION PASSWORDS OR SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=production
GLOBAL_PREFIX=api
APP_URL="http://localhost:8080"

# ------------------------------------------------------------------------------
# 2. Database Connection (MySQL 8.0 - Prisma ORM)
# ------------------------------------------------------------------------------
# - Production VPS: mysql://appuser:password@127.0.0.1:3307/dinhduong_v2?connection_limit=5&pool_timeout=10
# - Local Dev: mysql://dangtai:12345678@127.0.0.1:3306/dinhduong?connection_limit=7&pool_timeout=10
DATABASE_URL="mysql://db_user:replace_with_strong_db_password@127.0.0.1:3306/nutri_db?connection_limit=7&pool_timeout=10"
TEST_DATABASE_URL="mysql://db_user:replace_with_strong_db_password@127.0.0.1:3306/nutri_test?connection_limit=5&timezone=Z"

# ------------------------------------------------------------------------------
# 3. Native JWT Authentication & Security Signature
# ------------------------------------------------------------------------------
# Bắt buộc trong production: Chuỗi ngẫu nhiên tối thiểu 32 ký tự (High Entropy)
JWT_SECRET="replace_with_at_least_32_character_cryptographically_secure_random_string"
STORAGE_HMAC_SECRET="replace_with_at_least_32_char_random_hmac_secret_for_signed_urls"

# ------------------------------------------------------------------------------
# 4. File Upload & Storage (Local Disk VPS - Không cần MinIO)
# ------------------------------------------------------------------------------
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 5. SMTP Mailer Configuration (Nodemailer Pool)
# ------------------------------------------------------------------------------
# - Gmail SMTP: host="smtp.gmail.com", port=587 (STARTTLS), MAIL_PASS=16 ký tự Google App Password
# - Tự động fallback sang InMemoryMailerService nếu để trống hoặc chưa cấu hình
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="your_service_account@gmail.com"
MAIL_PASS="replace_with_google_app_password_16_chars"
MAIL_FROM="TrueNutri CSKH <your_service_account@gmail.com>"
MAIL_FROM_NAME="TrueNutri CSKH"
MAIL_FROM_ADDRESS="your_service_account@gmail.com"
MAIL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 6. Frontend URL & CORS Whitelist (Gom làm 1 biến duy nhất)
# ------------------------------------------------------------------------------
# - Hỗ trợ một hoặc nhiều domain (phân tách bởi dấu phẩy) để cấp phép CORS.
# - Domain đầu tiên trong danh sách được dùng làm base URL tạo link kích hoạt email.
FRONTEND_URL="https://ilove.truenutri.vn,https://truenutri.pages.dev,http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# 7. Google OAuth2 Login (Tùy chọn)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace_with_google_client_secret"
GOOGLE_REDIRECT_URI="postmessage"

# ------------------------------------------------------------------------------
# 8. Swagger / OpenAPI Hardening
# ------------------------------------------------------------------------------
# Trong production, mặc định ENABLE_SWAGGER=false để bảo mật tuyệt đối thông tin API.
# Nếu tạm thời bật trên staging/QA, hệ thống tự động khóa bằng HTTP Basic Auth.
ENABLE_SWAGGER="false"
SWAGGER_USER="nutri_swagger_admin"
SWAGGER_PASSWORD="replace_with_secure_random_swagger_password"

# ------------------------------------------------------------------------------
# 9. Embedded MySQL Asynchronous Queue Worker Tuning
# ------------------------------------------------------------------------------
QUEUE_POLL_INTERVAL_MS=3000
QUEUE_BATCH_SIZE=10
