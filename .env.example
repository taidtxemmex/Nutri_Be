# ==============================================================================
# Nutri Clinical Nutrition & Diet Management System - Environment Template
# Production Hardened Security Configuration
# NOTE: DO NOT COMMIT REAL PRODUCTION PASSWORDS OR SECRETS TO VERSION CONTROL!
# ==============================================================================

# Server Environment
PORT=8080
NODE_ENV=production
GLOBAL_PREFIX=api

# Database MySQL 8.0 (InnoDB Pool 512MB, Connection Limit 7 for 1 CPU / 2GB VPS)
DATABASE_URL="mysql://db_user:replace_with_strong_db_password@127.0.0.1:3306/nutri_db?connection_limit=7&pool_timeout=10"
TEST_DATABASE_URL="mysql://db_user:replace_with_strong_db_password@127.0.0.1:3306/nutri_test?connection_limit=5&timezone=Z"

# Native JWT Authentication (Minimum 32 characters, high entropy)
JWT_SECRET="replace_with_at_least_32_character_cryptographically_secure_random_string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Google OAuth2 Login
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace_with_google_client_secret"
GOOGLE_CALLBACK_URL="https://nutri.vn/api/auth/google/callback"

# File Upload & Storage (Defaults to public/uploads within project root)
MAX_FILE_SIZE_MB=10

# SMTP Gmail Mailer
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your_service_account@gmail.com"
MAIL_PASS="replace_with_google_app_password_16_chars"
MAIL_FROM="TrueNutri CSKH <your_service_account@gmail.com>"

# CORS & Client Whitelist (Comma-separated exact origins, no wildcard '*')
FRONTEND_URL="https://nutri.vn"
CORS_ORIGINS="https://nutri.vn,https://ilove.truenutri.vn,http://165.245.185.11"

# Swagger / OpenAPI Hardening
# In production, set ENABLE_SWAGGER=false to completely disable API docs.
# If temporarily enabled for staging/QA, HTTP Basic Auth is strictly enforced.
ENABLE_SWAGGER="false"
SWAGGER_USER="nutri_swagger_admin"
SWAGGER_PASSWORD="replace_with_secure_random_swagger_password"

# Rate Limiting (DDoS & Brute-Force Defense)
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL=60
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL=60
THROTTLE_SENSITIVE_LIMIT=3
THROTTLE_SENSITIVE_TTL=60
