# Server Environment
PORT=8080
NODE_ENV=development
GLOBAL_PREFIX=api/v1

# Database MySQL 8.0
DATABASE_URL="mysql://username:password@127.0.0.1:3306/dinhduong?connection_limit=7&pool_timeout=10"
TEST_DATABASE_URL="mysql://username:password@127.0.0.1:3306/nutri_test?connection_limit=5&timezone=Z"

# Native JWT Authentication
JWT_SECRET="replace_with_strong_secret_key"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Google OAuth2 Login
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:8080/api/v1/auth/google/callback"

# File Upload & Storage (Defaults to public/uploads within project root)
MAX_FILE_SIZE_MB=10

# SMTP Gmail Mailer
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your_email@gmail.com"
MAIL_PASS="your_app_password"
MAIL_FROM="TrueNutri CSKH <your_email@gmail.com>"

# CORS & Client
FRONTEND_URL="https://ilove.truenutri.vn"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://ilove.truenutri.vn"
